{
  "version": 2,
  "builds": [
    { "src": "api/**/*.ts", "use": "@vercel/node" },
    { "src": "dist/spa/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/server.ts" },
    { "src": "/assets/(.*)", "dest": "/dist/spa/assets/$1" },
    { "src": "/(.*).(css|js|map|png|jpg|jpeg|svg|ico|webp|woff2|ttf)", "dest": "/dist/spa/$1.$2" },
    { "src": "/(robots.txt|sitemap.xml)", "dest": "/dist/spa/$1" },
    { "src": "/(.*)", "dest": "/dist/spa/index.html" }
  ]
}
